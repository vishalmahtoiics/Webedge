# WebEdge Solution — backend configuration
#
# Copy to .env and fill in. Never commit .env, and never paste real values into
# a chat, an issue, or a commit. The API validates this at startup and refuses
# to boot if anything is missing or weak.

NODE_ENV=development          # development | test | staging | production
PORT=4000

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://webedge:CHANGE_ME@localhost:5432/webedge?schema=public"

# ─── Sessions ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30           # customer sessions
ADMIN_JWT_REFRESH_TTL_HOURS=12    # staff sessions expire far sooner

# ─── Provider credential encryption ──────────────────────────────────────────
# 32 bytes, hex-encoded: openssl rand -hex 32
# Encrypts Hostinger API tokens at rest. The version lets keys be rotated with
# overlap rather than re-encrypting everything at once.
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=v1

# ─── Origins ─────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# How often the subscription renewal sweep runs, in minutes. 0 switches it off,
# and a deployment with it off never renews or expires anything.
RENEWAL_SWEEP_MINUTES=60

# Must be true in production; the API refuses to start otherwise.
# It does not control the portal's session cookies. Those take their Secure
# flag from the scheme the reverse proxy reports in x-forwarded-proto, per
# request, so a deployment over plain HTTP signs in without changing anything
# here and one behind TLS is secure without changing anything either.
COOKIE_SECURE=false

# ─── Seeding (optional) ──────────────────────────────────────────────────────
# If SEED_ADMIN_PASSWORD is unset, the seed generates one and prints it once.
SEED_ADMIN_EMAIL=admin@webedgesolution.com
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
