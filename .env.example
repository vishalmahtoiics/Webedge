# WebEdge Solution — environment variables
#
# Copy to .env and fill in. NEVER commit .env, and never paste real values into
# a chat session or an issue (spec §2.3, §6.6).
#
# The application validates configuration at startup and fails fast when a
# required secret is missing (§6.6). This file documents names only.
#
# M0 scope: only the variables needed for the provider spike are listed. This
# file grows with each milestone — M1 adds sessions and the database, M5 adds
# Razorpay, M6 adds mail.

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=
# development | staging | production
# Outside production the provider adapter refuses writes unless the target
# resource name starts with `wetest-` or the account is flagged staging (§5.5).
WEBEDGE_ENV=

# ─── Provider: Hostinger ──────────────────────────────────────────────────────
# Base URL. Verified 2026-09-16 against @hostinger/sdk BASE_PATH.
HOSTINGER_API_BASE_URL=
# Staging API token (§2.3). There is no provider sandbox — a staging token still
# acts on a real account. Keep it separate from production and scope it tightly.
HOSTINGER_STAGING_API_TOKEN=
# Set true on provider accounts that are safe to write to during development.
HOSTINGER_STAGING_ACCOUNT=

# ─── Encryption ───────────────────────────────────────────────────────────────
# Provider credentials and SFTP passwords are encrypted at rest with a versioned
# key, so keys can be rotated with overlap (§5.4).
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=
