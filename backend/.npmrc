# No package may run code at install time.
#
# Three deploys to Enterprise Linux 8 failed compiling `argon2`, which had
# already been removed from package.json — a stale node_modules on the build
# host was enough to resurrect its build script. With scripts off it cannot
# run, whatever is left lying around.
#
# This is also ordinary supply-chain hygiene: an install script is arbitrary
# code from a package author, running with the deploying account's privileges,
# before anything is reviewed.
#
# What this costs: Prisma's client is generated by an install script, so the
# build runs `prisma generate` explicitly. `npm run build` does it, and so does
# the installer. Nothing else in this project needs one — `ssh2` only probes for
# an optional accelerator, and `@nestjs/core` prints a donation notice.
ignore-scripts=true
