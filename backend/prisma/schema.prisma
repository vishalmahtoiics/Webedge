// WebEdge Solution — core data model
//
// Two identity realms, deliberately separate tables rather than one `users` table
// with a discriminator (blueprint §22: "Separate admin authentication and permissions
// from customer authentication"). A single table makes it one forgotten WHERE clause
// for a customer session to authorize a staff route; separate tables make that
// mistake impossible to express.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Realm {
  ADMIN
  CUSTOMER
}

enum AdminRoleName {
  SUPER_ADMIN
  ADMIN
  SUPPORT_STAFF
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum ProviderKind {
  HOSTINGER
}

enum ProviderAccountStatus {
  ACTIVE
  DISABLED
  DEGRADED
}

enum WebsiteStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  FAILED
  ORPHANED
}

enum DomainStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  PENDING_TRANSFER
  PENDING_VERIFICATION
}

enum DnsRecordType {
  A
  AAAA
  CNAME
  MX
  TXT
  SRV
  NS
  CAA
}

/// An invoice and a credit note are the same table and the same serial
/// sequence — a credit note is a tax document in its own right — but they are
/// not the same document, and a page that cannot tell them apart shows a credit
/// note as an invoice for a negative amount.
enum InvoiceKind {
  INVOICE
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  BIENNIAL
  TRIENNIAL
}

/// Controls whether an activity entry is shown to the customer in their own
/// activity feed. Internal staff actions stay INTERNAL.
enum LogVisibility {
  CUSTOMER
  INTERNAL
}

// ─────────────────────────── Identity & access ───────────────────────────

/// A staff login. Invite-only; 2FA is mandatory for SUPER_ADMIN (§22).
model AdminUser {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  passwordHash String
  fullName     String
  status       AccountStatus @default(ACTIVE)

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  totpSecret         String?
  totpEnabledAt      DateTime?
  recoveryCodeHashes String[]  @default([])

  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@index([status])
  @@map("admin_users")
}

/// The tenant. Every customer-owned resource hangs off this, and every customer
/// query is scoped by customerId.
model Customer {
  id          String        @id @default(uuid()) @db.Uuid
  companyName String?
  fullName    String
  email       String        @unique
  phone       String?
  status      AccountStatus @default(PENDING_VERIFICATION)

  /// Place of supply for GST; the customer's own GSTIN when they have one.
  billingState String?
  gstin        String?

  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         CustomerUser[]
  websites      Website[]
  domains       Domain[]
  subscriptions Subscription[]
  notifications Notification[]
  invoices      Invoice[]
  mailDomains   MailDomain[]

  @@index([status])
  @@map("customers")
}

/// A login belonging to a Customer. Modelled as its own table from the start so
/// customer team members can be added later without re-architecting ownership.
model CustomerUser {
  id           String        @id @default(uuid()) @db.Uuid
  customerId   String        @db.Uuid
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email        String        @unique
  passwordHash String
  fullName     String
  status       AccountStatus @default(PENDING_VERIFICATION)

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  emailVerifiedAt DateTime?
  totpSecret      String?
  totpEnabledAt   DateTime?

  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@index([customerId])
  @@map("customer_users")
}

/// Roles are realm-scoped: a CUSTOMER role can never be attached to an AdminUser
/// in a way that grants staff permissions, because the permission keys themselves
/// are realm-scoped too.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  realm       Realm
  name        String
  description String?
  /// System roles are seeded and cannot be deleted through the admin UI.
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions   RolePermission[]
  adminUsers    AdminUser[]
  customerUsers CustomerUser[]

  @@unique([realm, name])
  @@map("roles")
}

/// Seeded idempotently from a fixed catalog. Custom staff roles are composed
/// from these keys rather than from free text.
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  /// e.g. "files.delete", "admin.providers.credentials"
  key         String @unique
  module      String
  realm       Realm
  description String

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Refresh tokens are stored hashed. The raw token is returned to the client once
/// and never persisted, so a database read cannot mint a session.
model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  realm     Realm

  adminUserId    String?       @db.Uuid
  adminUser      AdminUser?    @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  customerUserId String?       @db.Uuid
  customerUser   CustomerUser? @relation(fields: [customerUserId], references: [id], onDelete: Cascade)

  /// Set when this token is rotated, pointing at its replacement. Reuse of a
  /// rotated token indicates theft and revokes the whole family.
  replacedById String?   @db.Uuid
  revokedAt    DateTime?

  userAgent String?
  ipAddress String?

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminUserId])
  @@index([customerUserId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ───────────────────────────── Provider layer ─────────────────────────────

/// An upstream provider account. Credentials live in ApiCredential so they can be
/// rotated with overlap without touching this row.
model HostingAccount {
  id          String                @id @default(uuid()) @db.Uuid
  provider    ProviderKind          @default(HOSTINGER)
  accountName String
  status      ProviderAccountStatus @default(ACTIVE)

  /// Free-form provider product family, e.g. "agency-hosting" or "shared".
  /// Drives which capability set applies (blueprint §23).
  productFamily String?

  websiteSlotsTotal Int?
  websiteSlotsUsed  Int       @default(0)
  lastSyncedAt      DateTime?
  lastErrorAt       DateTime?
  lastError         String?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credentials ApiCredential[]
  websites    Website[]
  discovered  DiscoveredResource[]

  @@index([status])
  @@map("hosting_accounts")
}

/// Encrypted provider credentials. `keyVersion` names the encryption key used, so
/// keys can be rotated without decrypting everything at once. The ciphertext never
/// leaves the server and is never serialized into an API response.
/// What kind of thing was found on the provider.
enum DiscoveredKind {
  DOMAIN
  WEBSITE
  VPS
  SUBSCRIPTION
}

/// Something that exists on the provider account, as found by a sync.
///
/// Deliberately not a `Domain` or a `Website`: both of those are customer-owned
/// and carry a non-null `customerId`, because tenancy is the one invariant
/// nothing is allowed to weaken. A resource discovered on the provider has no
/// customer yet, and inventing one — or making the column nullable so it could
/// be absent — would put untenanted rows in the tables every tenant query
/// reads. This is infrastructure, like `HostingAccount`, and staff-only.
///
/// `raw` holds the provider's payload as received. The provider does not
/// publish response shapes — its own MCP package says "response structure will
/// depend on the API" — so the mapping to `name`, `status` and `expiresAt` is
/// by candidate key name and can be wrong. Keeping the payload means a mapping
/// corrected later is applied to what was already fetched, rather than needing
/// every account re-synced.
model DiscoveredResource {
  id               String         @id @default(uuid()) @db.Uuid
  hostingAccountId String         @db.Uuid
  hostingAccount   HostingAccount @relation(fields: [hostingAccountId], references: [id], onDelete: Cascade)

  kind DiscoveredKind

  /// Stable identity within an account and kind, for re-running a sync without
  /// duplicating. The provider's own id when it gave one, else the name.
  providerKey String

  /// Null when no candidate key matched. Left null rather than filled with a
  /// placeholder: a made-up name is worse than a visibly missing one.
  name      String?
  status    String?
  expiresAt DateTime?

  /// The provider's payload, as received.
  raw Json
  /// Which target fields a key was found for. Absent ones are the mapping's gaps.
  mapped String[] @default([])

  /// Set once a staff member attaches this to a customer.
  claimedByCustomerId String? @db.Uuid

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hostingAccountId, kind, providerKey])
  @@index([hostingAccountId, kind])
  @@map("discovered_resources")
}

model ApiCredential {
  id               String         @id @default(uuid()) @db.Uuid
  hostingAccountId String         @db.Uuid
  hostingAccount   HostingAccount @relation(fields: [hostingAccountId], references: [id], onDelete: Cascade)

  label          String
  ciphertext     String
  iv             String
  authTag        String
  keyVersion     String
  /// Last four characters of the plaintext token, for display only.
  lastFour       String?
  expiresAt      DateTime?
  lastVerifiedAt DateTime?
  revokedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostingAccountId])
  @@map("api_credentials")
}

// ─────────────────────────── Customer resources ───────────────────────────

model Website {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  hostingAccountId String?         @db.Uuid
  hostingAccount   HostingAccount? @relation(fields: [hostingAccountId], references: [id], onDelete: SetNull)

  domain String        @unique
  status WebsiteStatus @default(PROVISIONING)

  /// The provider's own identifier for this resource. Internal only — never
  /// serialized to a customer response (blueprint §27).
  providerResourceId String?
  /// Provider hosting-account username, where the product family scopes by account.
  providerUsername   String?
  documentRoot       String?
  phpVersion         String?

  diskUsedBytes BigInt?
  lastSyncedAt  DateTime?

  sftpCredential WebsiteSftpCredential?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([hostingAccountId])
  @@index([status])
  @@map("websites")
}

model Domain {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  name   String       @unique
  status DomainStatus @default(ACTIVE)

  registrar      String?
  expiresAt      DateTime?
  autoRenew      Boolean   @default(true)
  registrarLock  Boolean   @default(true)
  privacyEnabled Boolean   @default(false)
  nameservers    String[]  @default([])

  /// True when WebEdge manages this zone and can write records.
  dnsManaged   Boolean   @default(false)
  lastSyncedAt DateTime?

  dnsRecords DnsRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([expiresAt])
  @@map("domains")
}

// ───────────────────────────── Plans & billing ─────────────────────────────

/// A DNS record in a zone WebEdge manages.
///
/// Stored locally as the source of truth for the UI, then applied upstream.
/// `providerSyncedAt` records when the provider last confirmed it, so the UI can
/// show a record as still propagating rather than pretending it is live.
model DnsRecord {
  id       String @id @default(uuid()) @db.Uuid
  domainId String @db.Uuid
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  type     DnsRecordType
  /// '@' for the zone apex, otherwise a relative label such as 'www'.
  name     String
  value    String
  ttl      Int           @default(3600)

  /// MX and SRV.
  priority Int?
  /// SRV only.
  weight   Int?
  port     Int?

  /// Records WebEdge created and depends on, such as the website A record and
  /// email DNS. The UI labels these and warns before an edit.
  managedByWebEdge Boolean @default(false)

  providerRecordId String?
  providerSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domainId])
  @@index([domainId, name])
  @@map("dns_records")
}

/// SFTP access for one website.
///
/// Separate from Website because it is a credential: it is written by the
/// mapping wizard, read only by the file transport, and never serialized into
/// any response. The password is encrypted with the same versioned key as
/// provider tokens.
///
/// Hostinger exposes SFTP host, username and port through the Agency Hosting
/// website record, but not the password — that has to be set in the provider
/// panel and entered here, which is the main operational cost of onboarding a
/// website.
model WebsiteSftpCredential {
  id        String  @id @default(uuid()) @db.Uuid
  websiteId String  @unique @db.Uuid
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  host     String
  port     Int    @default(22)
  username String
  /// Absolute path this website is confined to. Every file path resolves
  /// against it, and nothing outside it is reachable.
  root     String

  ciphertext String
  iv         String
  authTag    String
  keyVersion String

  lastVerifiedAt DateTime?
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("website_sftp_credentials")
}

/// Allocates invoice serial numbers.
///
/// GST requires a consecutive serial number, unique within a financial year, with
/// no gaps (Rule 46(b), CGST Rules). One row per financial year, incremented
/// atomically — a read-then-write would hand the same number to two concurrent
/// invoices, which is exactly the defect an auditor looks for.
model InvoiceSequence {
  /// Indian financial year, April to March, as "2026-27".
  financialYear String @id
  lastNumber    Int    @default(0)

  updatedAt DateTime @updatedAt

  @@map("invoice_sequences")
}

/// An issued invoice.
///
/// Amounts are denormalised onto the row rather than recomputed on read: an
/// invoice is a legal record of what was charged at the time, and it must not
/// change because a tax rate or a plan price changed afterwards.
model Invoice {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// e.g. "WEB/2026-27/00001". Null only while DRAFT — a number is allocated at
  /// issue, so an abandoned draft cannot leave a gap in the sequence.
  invoiceNumber String? @unique
  financialYear String?
  serialNumber  Int?

  kind   InvoiceKind   @default(INVOICE)
  status InvoiceStatus @default(DRAFT)

  /// Set on a credit note: Rule 53(1A) of the CGST Rules requires it to carry
  /// the number and date of the invoice it revises. Both are snapshotted rather
  /// than joined, for the same reason every other party detail here is.
  againstInvoiceId     String?   @db.Uuid
  againstInvoiceNumber String?
  againstInvoiceDate   DateTime?

  /// Snapshot of both parties as they were when the invoice was issued.
  supplierStateCode String
  supplierGstin     String?
  customerName      String
  customerGstin     String?
  customerStateCode String
  placeOfSupply     String
  /// CGST_SGST | IGST | ZERO_RATED
  taxKind           String

  subtotalInPaise  Int
  discountInPaise  Int @default(0)
  cgstInPaise      Int @default(0)
  sgstInPaise      Int @default(0)
  igstInPaise      Int @default(0)
  roundOffInPaise  Int @default(0)
  totalInPaise     Int

  /// Set only on a renewal invoice, and the reason the renewal worker cannot
  /// charge twice for one period. `periodStart` is the subscription's renewal
  /// date before it was advanced, so it names the period exactly. The unique
  /// index below is what enforces it — a second attempt fails on the constraint
  /// inside the same transaction that allocates the serial, so no number is
  /// burned and the sequence stays gapless. Both are null on every other
  /// document, and Postgres treats nulls in a unique index as distinct, so
  /// manual invoices and credit notes never collide with each other.
  subscriptionId String?   @db.Uuid
  periodStart    DateTime?

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?
  voidedAt DateTime?
  /// A void invoice keeps its number: GST allows cancellation, never deletion,
  /// because a missing number reads as a gap.
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines InvoiceLine[]

  @@unique([subscriptionId, periodStart])
  @@index([customerId, createdAt])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description       String
  sacCode           String
  quantity          Int
  unitPriceInPaise  Int
  gstRateBps        Int
  taxableValueInPaise Int
  cgstInPaise       Int @default(0)
  sgstInPaise       Int @default(0)
  igstInPaise       Int @default(0)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model HostingPlan {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  description String?
  isPublic    Boolean @default(true)
  isActive    Boolean @default(true)

  /// Limits. Null means unlimited.
  maxWebsites    Int?
  maxDomains     Int?
  maxDatabases   Int?
  maxMailboxes   Int?
  storageGb      Int?
  mailboxQuotaGb Int?

  /// Price in paise, to avoid floating-point money.
  priceInPaise Int
  billingCycle BillingCycle @default(YEARLY)

  /// The provider product this plan is fulfilled by. Internal only.
  providerProduct String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isPublic, isActive])
  @@map("hosting_plans")
}

model Subscription {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  planId String      @db.Uuid
  plan   HostingPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  status      SubscriptionStatus @default(ACTIVE)
  startsAt    DateTime           @default(now())
  renewsAt    DateTime
  cancelledAt DateTime?
  autoRenew   Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([renewsAt])
  @@map("subscriptions")
}

// ────────────────────────── Audit & notifications ──────────────────────────

/// Append-only. The application database role is granted INSERT and SELECT only;
/// UPDATE and DELETE are revoked in a migration, so a compromised API cannot
/// rewrite its own trail.
model ActivityLog {
  id String @id @default(uuid()) @db.Uuid

  /// Who acted. Exactly one is set for a user action; both null for system
  /// actions such as a sync worker.
  ///
  /// Deliberately NOT foreign keys. An audit row must outlive the account that
  /// created it: with `onDelete: SetNull` the trail would silently lose its
  /// actor, and with a real FK the append-only trigger makes the account
  /// undeletable at all, because the cascade is an UPDATE. Plain columns plus an
  /// email snapshot keep the row both immutable and readable after the account
  /// is gone.
  adminUserId    String? @db.Uuid
  customerUserId String? @db.Uuid

  /// The actor's email as it was at the time of the action, so the trail stays
  /// legible after the account is deleted or its address changes.
  actorEmail String?

  /// Set when a staff member acted while impersonating a customer.
  impersonatorAdminId String? @db.Uuid

  /// Which tenant the action affected. Also not a foreign key, for the same
  /// reason: terminating a customer must not rewrite or block their audit trail.
  customerId String? @db.Uuid

  /// e.g. "dns.record.updated", "files.deleted"
  action       String
  resourceType String?
  resourceId   String?

  /// Redacted before-and-after values. Secrets are replaced with a marker by the
  /// logging service, never stored raw.
  oldValue Json?
  newValue Json?

  visibility LogVisibility @default(INTERNAL)

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

/// Ownership of a mail domain must be proved before mail is accepted for it.
/// Without that, one customer adds another's domain and starts receiving their
/// mail — the whole platform's worst failure, and a trivially easy one.
enum MailDomainStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

model MailDomain {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// Always stored lowercase. Mail domains are case-insensitive, and storing two
  /// casings would let the same domain be claimed twice, by two tenants.
  name   String           @unique
  status MailDomainStatus @default(PENDING_VERIFICATION)

  /// Random, per domain, published as a TXT record to prove control. Not a
  /// secret — it is meant to be public — but unguessable so it cannot be
  /// pre-published by someone who does not own the domain.
  verificationToken String
  verifiedAt        DateTime?

  /// Total space this domain's mailboxes may use, in mebibytes. Null is
  /// unlimited, which is a decision rather than an absence.
  quotaMib Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mailboxes Mailbox[]
  aliases   MailAlias[]

  @@index([customerId])
  @@map("mail_domains")
}

model Mailbox {
  id       String     @id @default(uuid()) @db.Uuid
  domainId String     @db.Uuid
  domain   MailDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  /// The part before the @, stored lowercase. Comparison is case-insensitive
  /// everywhere: treating Asha@ and asha@ as two mailboxes puts two people's
  /// mail in one place, or loses one of them.
  localPart String

  /// Dovecot password scheme string, e.g. "{ARGON2ID}$argon2id$v=19$...".
  /// Hashed by WebEdge and verified by Dovecot directly — no plaintext ever
  /// crosses a process boundary, and nothing here can recover a password.
  passwordHash String

  displayName String?
  quotaMib    Int?
  /// Last known usage, from the mail server. Null means never measured, which is
  /// shown as "Not available" rather than as zero.
  usedMib     Int?
  usageSyncedAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([domainId, localPart])
  @@index([domainId])
  @@map("mailboxes")
}

/// An alias forwards one address to one or more destinations. Destinations may
/// be other aliases, which is why resolution has to detect cycles.
model MailAlias {
  id       String     @id @default(uuid()) @db.Uuid
  domainId String     @db.Uuid
  domain   MailDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  /// "*" is a catch-all for the domain, and is the one localpart that is not a
  /// valid address in its own right.
  localPart String

  /// Full addresses, stored lowercase.
  destinations String[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([domainId, localPart])
  @@index([domainId])
  @@map("mail_aliases")
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// success | info | warning | security
  category  String
  title     String
  body      String
  actionUrl String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([customerId, readAt])
  @@map("notifications")
}
